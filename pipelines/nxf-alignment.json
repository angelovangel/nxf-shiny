{
  "name": "nxf-alignment",
  "fullname": "angelovangel/nxf-alignment",
  "url": "https://github.com/angelovangel/nxf-alignment",
  "shiny_inputs": [
    {
      "type": "shinyDirButton",
      "inputId": "pod5",
      "id": "pod5",
      "label": "POD5 folder",
      "title": "Select folder containing pod5 files",
      "panel_condition": "!input.reads",
      "help": "Folder containing pod5 files to be basecalled",
      "required": false
    },
    {
      "type": "textInput",
      "inputId": "model",
      "label": "Dorado model",
      "required": false,
      "value": "fast",
      "panel_condition": "input.pod5",
      "help": "Dorado basecalling model to use"
    },
    {
      "type": "checkboxInput",
      "inputId": "herro",
      "label": "Enable HERRO read correction",
      "required": false,
      "value": false,
      "panel_condition": "input.pod5"
    },
    {
      "type": "shinyDirButton",
      "inputId": "reads",
      "id": "reads",
      "label": "FASTQ/BAM reads",
      "title": "Select folder with FASTQ/BAM files",
      "multiple": false,
      "required": false,
      "panel_condition": "!input.pod5",
      "help": "Directory with reads (BAM/FASTQ files, skips basecalling)"
    },
    {
      "type": "shinyFilesButton",
      "inputId": "asfile",
      "id": "asfile",
      "label": "Adaptive sampling file",
      "title": "Adaptive sampling file",
      "multiple": false,
      "required": false,
      "panel_condition": "input.pod5",
      "help": "Path to adaptive sampling decisions file, filters reads to basecall"
    },
    {
      "type": "checkboxInput",
      "inputId": "advanced_barcoded",
      "label": "Barcoded run",
      "required": false,
      "value": false,
      "panel_condition": "input.pod5"
    },
    {
      "type": "selectInput",
      "inputId": "kit",
      "label": "Barcoding kit",
      "required": false,
      "multiple": false,
      "panel_condition": "input.advanced_barcoded",
      "choices": {
        "": "",
        "SQK-16S024": "SQK-16S024",
        "SQK-16S114-24": "SQK-16S114-24",
        "SQK-NBD114-24": "SQK-NBD114-24",
        "SQK-NBD114-96": "SQK-NBD114-96",
        "SQK-PCB114-24": "SQK-PCB114-24",
        "SQK-RBK114-24": "SQK-RBK114-24",
        "SQK-RBK114-96": "SQK-RBK114-96",
        "SQK-RPB114-24": "SQK-RPB114-24",
        "TWIST-16-UDI": "TWIST-16-UDI",
        "TWIST-96A-UDI": "TWIST-96A-UDI",
        "VSK-PTC001": "VSK-PTC001",
        "VSK-VMK001": "VSK-VMK001",
        "VSK-VMK004": "VSK-VMK004",
        "VSK-VPS001": "VSK-VPS001"
      },
      "help": "Barcoding kit name (required with --samplesheet)"
    },
    {
      "type": "fileInput",
      "inputId": "samplesheet",
      "label": "Samplesheet",
      "required": false,
      "multiple": false,
      "accept": [
        ".csv"
      ],
      "placeholder": "Upload samplesheet",
      "panel_condition": "input.advanced_barcoded",
      "help": "CSV with columns: sample,barcode (required with --kit)"
    },
    {
      "type": "shinyFilesButton",
      "inputId": "ref",
      "id": "ref",
      "label": "Reference file",
      "title": "Reference file (fasta)",
      "multiple": false,
      "required": true,
      "help": "Path to reference FASTA (required unless -entry basecall is used)"
    },
    {
      "type": "shinyFilesButton",
      "inputId": "bed",
      "id": "bed",
      "label": "BED file",
      "title": "BED file",
      "required": false,
      "multiple": false,
      "help": "BED file with regions (auto-generated from reference if omitted)"
    },
    {
      "type": "checkboxInput",
      "inputId": "snp",
      "label": "Enable SNP calling",
      "required": false,
      "value": false,
      "help": "Enable variant calling on the aligned reads using Clair3 or DeepVariant"
    },
    {
      "type": "selectInput",
      "inputId": "snp_caller",
      "label": "SNP caller",
      "required": false,
      "panel_condition": "input.snp",
      "choices": {
        "clair3": "clair3",
        "deepvariant": "deepvariant"
      }
    },
    {
      "type": "selectInput",
      "inputId": "clair3_platform",
      "label": "Clair3 platform",
      "required": false,
      "multiple": false,
      "panel_condition": "input.snp && input.snp_caller == 'clair3'",
      "choices": {
        "ont": "ont",
        "hifi": "hifi",
        "ilmn": "ilmn"
      },
      "help": "The platform for which the Clair3 model was trained. Only used when --snp is specified."
    },
    {
      "type": "textInput",
      "inputId": "clair3_model",
      "label": "Clair3 model",
      "required": false,
      "value": "r1041_e82_400bps_hac_v500",
      "panel_condition": "input.snp && input.snp_caller == 'clair3'",
      "help": "The specific Clair3 model name. Only used when --snp is specified. See available models in the Clair3 documentation."
    },
    {
      "type": "selectInput",
      "inputId": "deepvariant_model",
      "label": "DeepVariant model",
      "required": false,
      "multiple": false,
      "panel_condition": "input.snp && input.snp_caller == 'deepvariant'",
      "choices": {
        "ONT_R104": "ONT_R104",
        "PACBIO": "PACBIO",
        "WGS": "WGS",
        "WES": "WES",
        "HYBRID_PACBIO_ILLUMINA": "HYBRID_PACBIO_ILLUMINA"
      }
    },
    {
      "type": "checkboxInput",
      "inputId": "phase",
      "label": "Phase variants",
      "required": false,
      "value": false,
      "panel_condition": "input.snp",
      "help": "Phase SNP variants using WhatsHap, only diploid cases supported"
    },
    {
      "type": "checkboxInput",
      "inputId": "annotate",
      "label": "Annotate variants",
      "required": false,
      "value": false,
      "panel_condition": "input.snp",
      "help": "Annotate variants using snpEff"
    },
    {
      "type": "textInput",
      "inputId": "anno_db",
      "label": "snpEff annotation database",
      "required": false,
      "value": "hg38",
      "panel_condition": "input.snp && input.annotate",
      "help": "snpEff annotation database to use"
    },
    {
      "type": "checkboxInput",
      "inputId": "sv",
      "label": "Enable SV calling",
      "required": false,
      "value": false,
      "help": "Enable structural variant calling with Sniffles2"
    },
    {
      "type": "checkboxInput",
      "inputId": "advanced",
      "label": "Advanced",
      "required": false,
      "value": false
    },
    {
      "type": "numericInput",
      "inputId": "cpus",
      "label": "Number of CPUs",
      "required": false,
      "value": 64,
      "panel_condition": "input.advanced"
    },
    {
      "type": "textInput",
      "inputId": "profile",
      "label": "Profile",
      "required": false,
      "value": "",
      "panel_condition": "input.advanced"
    }
  ]
}